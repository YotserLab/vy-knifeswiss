# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# Mailtrap Email API Configuration
# Get your API token from https://mailtrap.com/api-tokens
MAILTRAP_API_TOKEN=YOUR_MAILTRAP_API_TOKEN
# Mailtrap API endpoint (typically https://send.api.mailtrap.io/api/send)
MAILTRAP_API_URL=https://send.api.mailtrap.io/api/send

# OAuth Client IDs for cloud sync
GDRIVE_CLIENT_ID=YOUR_GDRIVE_CLIENT_ID.apps.googleusercontent.com
ONEDRIVE_CLIENT_ID=YOUR_ONEDRIVE_CLIENT_ID
DROPBOX_CLIENT_ID=YOUR_DROPBOX_APP_KEY
PCLOUD_CLIENT_ID=YOUR_PCLOUD_CLIENT_ID
